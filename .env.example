# Zkopíruj do .env a vyplň. Soubor .env se nikdy necommituje.

# --- API ---
DATABASE_URL=postgresql://mtsales:mtsales@localhost:5432/mtsales
DATABASE_URL_TEST=postgresql://mtsales:mtsales@localhost:5432/mtsales_test
# Vygeneruj: openssl rand -base64 48
JWT_SECRET=
# Vygeneruj: openssl rand -base64 32
APP_ENCRYPTION_KEY=
APP_ORIGINS=http://localhost:8081
COOKIE_SECURE=false
LOG_LEVEL=info
PORT=3000

# --- První manažer (pnpm db:seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# --- Aplikace (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

{
  "name": "mtsales",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @mtsales/api dev",
    "dev:app": "pnpm --filter @mtsales/app dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mtsales/db generate",
    "db:migrate": "pnpm --filter @mtsales/db migrate",
    "db:seed": "pnpm --filter @mtsales/api seed"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
